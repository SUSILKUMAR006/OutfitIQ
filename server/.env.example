# Copy to server/.env and fill in. server/.env is git-ignored.

# Google Gemini key for AI photo tagging (https://aistudio.google.com/apikey). Leave empty to turn AI off.
GEMINI_API_KEY=

# Optional: override the Gemini model used for tagging.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: override the Gemini model used by the AI stylist agent (function calling).
# GEMINI_AGENT_MODEL=gemini-3.5-flash
